<!DOCTYPE html>
<html lang="hi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#829567">
<meta name="description" content="Aaditya & Arav — शुभ सगाई समारोह, 21 फरवरी 2027">
<title>Aaditya & Arav | सप्रेम सगाई निमंत्रण</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&family=Gotu&family=Hind:wght@400;500;600;700&family=Yatra+One&family=DM+Serif+Display&display=swap" rel="stylesheet">
<style>
:root{
  --paper:#fcf8f1;
  --paper2:#f4ebdc;
  --gold:#b88e4e;
  --gold2:#dfc699;
  --ink:#4a3f33;
  --wine:#6a2d33;
  --rose:#c78783;
  --sage:#5c6c49;
  --gate-green:#829567;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{
  margin:0;
  background:#ede7db;
  color:var(--ink);
  font-family:'Hind',sans-serif;
  min-height:100vh;
}
button,a,input,textarea{font:inherit}

.site{
  width:min(100%,480px);
  margin:auto;
  position:relative;
  min-height:100vh;
  background:#fcf8f1;
  box-shadow:0 12px 45px rgba(60,50,30,0.2);
  overflow:hidden;
}

/* First Page: Gatefold Door Section */
.gatefold-stage{
  position:relative;
  min-height:100svh;
  display:grid;
  place-items:center;
  padding:16px 12px;
  background:#ede7db;
  perspective:1600px;
  transition:all .9s cubic-bezier(0.4,0,0.2,1);
}
.gatefold-card{
  position:relative;
  height:min(88svh,650px);
  aspect-ratio:400 / 643;
  max-width:92vw;
  border-radius:6px;
  box-shadow:0 18px 48px rgba(50,42,28,0.32);
  cursor:pointer;
  perspective:1600px;
  transform-style:preserve-3d;
  user-select:none;
  background:#fcf8f1;
  overflow:hidden;
}

/* Inner Revealed Card (Sitting directly beneath the doors) */
.inner-cover{
  position:absolute;
  inset:0;
  width:100%;
  height:100%;
  border-radius:6px;
  overflow:hidden;
  z-index:1;
  background:#fdfbf8;
}
.inner-cover-img{
  width:100%;
  height:100%;
  object-fit:cover;
  display:block;
}

/* Names Overlay over the Italian Villa Canvas */
.names-overlay{
  position:absolute;
  top:23.5%;
  left:50%;
  transform:translateX(-50%);
  width:78%;
  text-align:center;
  z-index:2;
  pointer-events:none;
}
.couple-name{
  font-family:'Cormorant Garamond',serif;
  font-size:clamp(32px,8.2vw,43px);
  font-weight:600;
  color:#453a2f;
  line-height:1.15;
  letter-spacing:1px;
  text-shadow:0 1px 2px rgba(255,255,255,0.7);
  opacity:0;
  transform:translateY(16px) scale(0.97);
  filter:blur(6px);
  transition:opacity 1.2s cubic-bezier(0.16,1,0.3,1),transform 1.2s cubic-bezier(0.16,1,0.3,1),filter 1.2s ease;
}
.ampersand{
  font-family:'Cormorant Garamond',serif;
  font-style:italic;
  font-size:clamp(24px,6.2vw,30px);
  color:#574a3b;
  margin:4px 0;
  line-height:1;
  opacity:0;
  transform:translateY(14px) scale(0.95);
  filter:blur(6px);
  transition:opacity 1.1s cubic-bezier(0.16,1,0.3,1),transform 1.1s cubic-bezier(0.16,1,0.3,1),filter 1.1s ease;
}
.event-date{
  font-family:'Cormorant Garamond',serif;
  font-size:clamp(13px,3.4vw,16px);
  font-weight:500;
  color:#5f5344;
  letter-spacing:2.5px;
  margin-top:16px;
  text-transform:none;
  opacity:0;
  transform:translateY(12px);
  filter:blur(5px);
  transition:opacity 1.2s cubic-bezier(0.16,1,0.3,1),transform 1.2s cubic-bezier(0.16,1,0.3,1),filter 1.2s ease;
}

/* Gradual staggered entrance when opened */
.gatefold-stage.opened .name-first{
  opacity:1;
  transform:translateY(0) scale(1);
  filter:blur(0);
  transition-delay:0.55s;
}
.gatefold-stage.opened .ampersand{
  opacity:1;
  transform:translateY(0) scale(1);
  filter:blur(0);
  transition-delay:0.95s;
}
.gatefold-stage.opened .name-second{
  opacity:1;
  transform:translateY(0) scale(1);
  filter:blur(0);
  transition-delay:1.4s;
}
.gatefold-stage.opened .event-date{
  opacity:1;
  transform:translateY(0);
  filter:blur(0);
  transition-delay:1.9s;
}

/* Left & Right Doors */
.door{
  position:absolute;
  top:0;
  bottom:0;
  width:50%;
  height:100%;
  transition:transform 1.35s cubic-bezier(0.25,1,0.35,1),opacity 1.35s ease,box-shadow 1.35s ease;
  z-index:5;
  backface-visibility:hidden;
}
.door-left{
  left:0;
  background-image:url('assets/door-left.jpg');
  background-repeat:no-repeat;
  background-size:100% 100%;
  transform-origin:left center;
  box-shadow:inset -2px 0 3px rgba(35,45,20,0.35);
  border-top-left-radius:6px;
  border-bottom-left-radius:6px;
}
.door-right{
  right:0;
  background-image:url('assets/door-right.jpg');
  background-repeat:no-repeat;
  background-size:100% 100%;
  transform-origin:right center;
  box-shadow:inset 2px 0 3px rgba(35,45,20,0.35);
  border-top-right-radius:6px;
  border-bottom-right-radius:6px;
}

/* Center Seam Shadow */
.seam-line{
  position:absolute;
  top:0;
  bottom:0;
  left:50%;
  width:1.5px;
  background:rgba(30,40,15,0.45);
  z-index:6;
  transform:translateX(-50%);
  pointer-events:none;
  transition:opacity .6s ease;
}

/* Center Ganesha Seal */
.seal-medallion{
  position:absolute;
  top:49.5%;
  left:50%;
  transform:translate(-50%,-50%);
  width:33.25%;
  aspect-ratio:1;
  z-index:12;
  pointer-events:none;
  filter:drop-shadow(0 6px 16px rgba(40,30,15,0.32));
  transition:transform .65s cubic-bezier(0.2,0.8,0.2,1),opacity .5s ease;
}
.seal-img{
  width:100%;
  height:100%;
  object-fit:contain;
  display:block;
}

/* Bottom "Tap to open" Pill Button */
.tap-open-btn{
  position:absolute;
  top:87.7%;
  left:50%;
  transform:translate(-50%,-50%);
  z-index:12;
  display:inline-flex;
  align-items:center;
  justify-content:center;
  gap:9px;
  padding:8px 22px;
  background:#fcf8f0;
  border:1px solid #c9bda5;
  border-radius:40px;
  color:#5d5343;
  font-family:'Gotu',serif;
  font-size:clamp(13px,3.3vw,15px);
  font-weight:500;
  letter-spacing:0.4px;
  box-shadow:0 4px 18px rgba(50,40,20,0.18);
  cursor:pointer;
  transition:transform .4s ease,opacity .4s ease,box-shadow .3s ease;
  animation:tapFloat 2.6s ease-in-out infinite;
}
.tap-open-btn:hover{
  background:#ffffff;
  box-shadow:0 6px 22px rgba(50,40,20,0.26);
}
.tap-open-btn .hand-icon{
  width:16px;
  height:16px;
  stroke:#5d5343;
  animation:handBob 1.3s ease-in-out infinite;
}
@keyframes handBob{0%,100%{transform:translateY(0)}50%{transform:translateY(-3px)}}
@keyframes tapFloat{0%,100%{transform:translate(-50%,-50%) translateY(0)}50%{transform:translate(-50%,-50%) translateY(-3px)}}

/* Opened State Transitions */
.gatefold-stage.opened .seal-medallion{
  transform:translate(-50%,-50%) scale(1.18);
  opacity:0;
  pointer-events:none;
}
.gatefold-stage.opened .tap-open-btn{
  opacity:0;
  transform:translate(-50%,-50%) scale(0.9);
  pointer-events:none;
}
.gatefold-stage.opened .seam-line{
  opacity:0;
}
.gatefold-stage.opened .door-left{
  transform:perspective(1400px) rotateY(-118deg);
  opacity:0;
  pointer-events:none;
}
.gatefold-stage.opened .door-right{
  transform:perspective(1400px) rotateY(118deg);
  opacity:0;
  pointer-events:none;
}
.gatefold-stage.opened{
  min-height:auto;
  padding:22px 12px 14px;
}
.gatefold-stage.opened .gatefold-card{
  cursor:default;
}

/* Details Section Revealed Below */
.invitation-details{
  display:none;
  position:relative;
  padding:16px 14px 48px;
  background:radial-gradient(ellipse at 50% 20%,#fffbf2 0,#f8f0e1 60%,#ede0cb 100%);
}
.invitation-details.show{
  display:block;
  animation:reveal 1s cubic-bezier(0.2,0.8,0.2,1) both;
}
@keyframes reveal{from{opacity:0;transform:translateY(28px)}to{opacity:1;transform:none}}

/* Styled Card Pages matching the video */
.card-page{
  position:relative;
  width:100%;
  max-width:410px;
  margin:18px auto 26px;
  border-radius:6px;
  overflow:hidden;
  box-shadow:0 14px 42px rgba(50,42,28,0.22);
  background:#fdfaf4;
  transition:transform .3s ease;
}
.card-page:hover{
  transform:translateY(-3px);
  box-shadow:0 18px 48px rgba(50,42,28,0.28);
}
.card-page img{
  width:100%;
  height:auto;
  display:block;
}

/* Page 4: A Heartfelt Invitation Card (Sticky Scroll & Animation) */
.heartfelt-pin-track{
  position:relative;
  width:100%;
  height:240vh;
  margin:18px 0 26px;
}
.heartfelt-sticky-box{
  position:sticky;
  top:12px;
  height:calc(100vh - 24px);
  max-height:650px;
  display:flex;
  align-items:center;
  justify-content:center;
  pointer-events:none;
}
.heartfelt-page{
  position:relative;
  width:100%;
  max-width:410px;
  height:100%;
  max-height:620px;
  aspect-ratio:1405 / 2087;
  border-radius:8px;
  box-shadow:0 16px 45px rgba(50,42,28,0.22);
  background:url('assets/scalloped-frame-clean.jpg') no-repeat center / 100% 100%;
  overflow:hidden;
  pointer-events:auto;
}
.scalloped-window{
  position:absolute;
  top:18.5%;
  bottom:15.5%;
  left:11.5%;
  right:11.5%;
  overflow:hidden;
}
.scalloped-content{
  width:100%;
  height:100%;
  display:flex;
  flex-direction:column;
  will-change:transform;
  transition:transform 0.08s ease-out;
}
.hf-slide{
  flex:0 0 100%;
  height:100%;
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  text-align:center;
  padding:8px 6px;
  color:#3a3227;
}

.heartfelt-title{
  font-family:'Cormorant Garamond',Georgia,serif;
  font-style:italic;
  font-size:clamp(26px,6.8vw,33px);
  font-weight:500;
  color:#393126;
  margin:0 0 16px;
  letter-spacing:0.5px;
}
.heartfelt-blessing{
  font-family:'Cormorant Garamond',Georgia,serif;
  font-size:clamp(14.5px,3.7vw,16.5px);
  line-height:1.65;
  color:#524536;
  margin:0 0 18px;
}
.heartfelt-announcement{
  font-family:'Cormorant Garamond',Georgia,serif;
  font-size:clamp(14.5px,3.7vw,16.5px);
  line-height:1.65;
  color:#43372c;
  font-weight:500;
  margin:0;
}
.couple-name-box{
  margin:4px 0;
  text-align:center;
}
.h-name{
  font-family:'Cormorant Garamond',Georgia,serif;
  font-size:clamp(28px,7.5vw,36px);
  font-weight:600;
  color:#3d3124;
  letter-spacing:0.5px;
  line-height:1.15;
}
.h-sub{
  font-family:'Cormorant Garamond',Georgia,serif;
  font-size:clamp(12px,2.9vw,14px);
  color:#635544;
  line-height:1.4;
  margin-top:3px;
}
.h-city{
  font-family:'Cormorant Garamond',Georgia,serif;
  font-size:clamp(11.5px,2.8vw,13px);
  color:#736452;
  line-height:1.35;
  margin-top:2px;
}
.h-with{
  display:flex;
  align-items:center;
  justify-content:center;
  gap:12px;
  margin:10px 0;
  color:#8b7352;
}
.h-with em{
  font-family:'Cormorant Garamond',Georgia,serif;
  font-style:italic;
  font-size:clamp(19px,4.8vw,23px);
  color:#6a5742;
}
.h-with span{
  font-size:14px;
  color:#9c8464;
}
.mini-top{
  margin-bottom:14px;
}
.h-name-mini{
  font-size:clamp(22px,5.5vw,27px);
}
.heartfelt-closing{
  font-family:'Cormorant Garamond',Georgia,serif;
  font-size:clamp(14.5px,3.7vw,16.5px);
  line-height:1.75;
  color:#524536;
  margin:0;
}

/* Engagement Celebrations Section (Single Point) */
.celebrations-card{
  width:100%;
  max-width:410px;
  margin:20px auto 26px;
  padding:32px 18px 36px;
  background:#fdfbf7;
  border:1px solid #e5d8c3;
  border-radius:8px;
  box-shadow:0 14px 42px rgba(50,42,28,0.18);
  text-align:center;
}
.celebrations-title{
  font-family:'Cormorant Garamond',Georgia,serif;
  font-size:clamp(30px,7.5vw,40px);
  font-weight:500;
  color:#3c3328;
  margin:0 0 28px;
  letter-spacing:0.5px;
}
.timeline-single{
  display:grid;
  grid-template-columns:105px 24px 1fr;
  align-items:center;
  gap:12px;
  text-align:left;
  padding:8px 0;
}
.timeline-art{
  display:flex;
  justify-content:center;
  align-items:center;
}
.timeline-art img{
  width:100%;
  max-width:105px;
  height:auto;
  display:block;
  object-fit:contain;
  filter:drop-shadow(0 6px 12px rgba(60,45,30,0.15));
}
.timeline-pearl-line{
  position:relative;
  height:130px;
  display:flex;
  align-items:center;
  justify-content:center;
}
.timeline-pearl-line::before{
  content:"";
  position:absolute;
  top:0;
  bottom:0;
  left:50%;
  transform:translateX(-50%);
  width:2px;
  background:repeating-linear-gradient(to bottom, #d4af37, #d4af37 3px, transparent 3px, transparent 7px);
  opacity:0.6;
}
.pearl-node{
  position:relative;
  z-index:2;
  width:16px;
  height:16px;
  border-radius:50%;
  background:radial-gradient(circle at 35% 35%, #ffffff 0%, #f7ecd7 55%, #dfc499 100%);
  box-shadow:0 2px 6px rgba(50,40,25,0.25), inset 0 1px 2px rgba(255,255,255,0.8);
  border:1px solid #d4af37;
}
.timeline-details{
  padding-left:4px;
}
.timeline-date{
  font-family:'Cormorant Garamond',Georgia,serif;
  font-size:clamp(22px,5.2vw,27px);
  font-weight:600;
  color:#43382c;
  line-height:1.2;
}
.timeline-event-name{
  font-size:12px;
  font-weight:600;
  letter-spacing:2px;
  color:#7e5e34;
  margin:6px 0 5px;
  text-transform:uppercase;
}
.timeline-location{
  font-size:13px;
  color:#6c5e4e;
  line-height:1.45;
}

/* Map Button */
.map-btn{
  display:inline-flex;
  align-items:center;
  gap:7px;
  margin-top:10px;
  padding:6px 15px;
  background:#faf4e8;
  border:1px solid #d4af37;
  border-radius:24px;
  color:#5a4a35;
  font-family:'Cormorant Garamond',Georgia,serif;
  font-size:13px;
  font-weight:600;
  text-decoration:none;
  box-shadow:0 2px 8px rgba(60,45,25,0.08);
  transition:all .2s ease;
}
.map-btn:hover{
  background:#ffffff;
  border-color:#b88e4e;
  transform:translateY(-1px);
  box-shadow:0 4px 12px rgba(60,45,25,0.16);
}

/* Page 8: Interactive RSVP Form with Pillars */
.rsvp-pillars-card{
  position:relative;
  width:100%;
  max-width:410px;
  margin:22px auto 26px;
  border-radius:6px;
  overflow:hidden;
  box-shadow:0 14px 42px rgba(50,42,28,0.22);
  background:#fdfaf4;
}
.rsvp-pillars-card .bg-img{
  width:100%;
  height:auto;
  display:block;
}
.rsvp-form-overlay{
  position:absolute;
  top:36.2%;
  bottom:23.8%;
  left:16.5%;
  right:16.5%;
  display:flex;
  flex-direction:column;
  justify-content:space-between;
  text-align:left;
  z-index:2;
}
.rsvp-field{
  display:flex;
  flex-direction:column;
  gap:3px;
}
.rsvp-field-header{
  display:flex;
  align-items:center;
  justify-content:space-between;
}
.rsvp-field label{
  font-family:'Cormorant Garamond',Georgia,serif;
  font-size:clamp(12px,3vw,13.5px);
  font-weight:600;
  color:#5a4a35;
  margin:0;
}
.field-counter{
  font-size:10.5px;
  color:#9a8872;
}
.rsvp-field input, .rsvp-field textarea{
  width:100%;
  background:#ffffff;
  border:1px solid #d8caa9;
  border-radius:6px;
  padding:5px 9px;
  font-family:'Cormorant Garamond',Georgia,serif;
  font-size:clamp(12.5px,3.1vw,14px);
  color:#3c3328;
  outline:none;
  box-shadow:inset 0 1px 3px rgba(0,0,0,0.03);
  transition:border-color .2s;
}
.rsvp-field input:focus, .rsvp-field textarea:focus{
  border-color:#829567;
}
.phone-input-wrap{
  position:relative;
  display:flex;
  align-items:center;
}
.phone-prefix-icon{
  position:absolute;
  left:8px;
  font-size:11px;
  opacity:0.6;
  pointer-events:none;
}
.phone-input-wrap input{
  padding-left:26px;
}
.rsvp-choice-row{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:8px;
}
.rsvp-choice-btn{
  padding:5px 4px;
  background:#ffffff;
  border:1px solid #d8caa9;
  border-radius:20px;
  font-family:'Cormorant Garamond',Georgia,serif;
  font-size:clamp(11.5px,2.9vw,13px);
  font-weight:600;
  color:#5a4a35;
  cursor:pointer;
  text-align:center;
  transition:all .2s ease;
}
.rsvp-choice-btn.active{
  background:#5c6c49;
  border-color:#4a5938;
  color:#ffffff;
}
.rsvp-send-btn{
  width:100%;
  padding:8px 12px;
  background:#5c6c49;
  border:none;
  border-radius:24px;
  font-family:'Cormorant Garamond',Georgia,serif;
  font-size:clamp(13px,3.4vw,15px);
  font-weight:600;
  color:#ffffff;
  cursor:pointer;
  box-shadow:0 3px 10px rgba(60,75,45,0.22);
  transition:all .2s ease;
  margin-top:2px;
}
.rsvp-send-btn:hover{
  background:#4d5c3c;
}

/* Floating Audio Toggle Pill */
.audio-toggle-btn{
  position:fixed;
  bottom:20px;
  right:16px;
  width:38px;
  height:38px;
  border-radius:50%;
  background:#435332;
  border:1px solid #758a5e;
  box-shadow:0 4px 14px rgba(30,40,20,0.35);
  display:flex;
  align-items:center;
  justify-content:center;
  cursor:pointer;
  z-index:50;
  transition:transform .2s ease, opacity .3s ease;
  opacity:0;
  pointer-events:none;
}
.audio-toggle-btn.visible{
  opacity:1;
  pointer-events:auto;
}
.audio-bars{
  display:flex;
  align-items:flex-end;
  gap:2.5px;
  height:14px;
}
.audio-bar{
  width:2.5px;
  background:#ffffff;
  border-radius:2px;
  animation:eqBounce 1.1s ease-in-out infinite alternate;
}
.audio-bar:nth-child(1){height:6px;animation-delay:0s}
.audio-bar:nth-child(2){height:13px;animation-delay:0.35s}
.audio-bar:nth-child(3){height:9px;animation-delay:0.18s}
.audio-toggle-btn.muted .audio-bar{
  animation:none;
  height:3px;
  opacity:0.6;
}
@keyframes eqBounce{0%{height:4px}100%{height:14px}}

/* Page Final Spacing */
#pageChateauFinal{
  margin-bottom:36px;
}

/* Petals Animation */
.petals{position:fixed;inset:0;overflow:hidden;pointer-events:none;z-index:40}
.petal{position:absolute;top:-20px;width:10px;height:15px;border-radius:80% 0 80% 0;background:#d89897;opacity:.65;animation:fall linear forwards}
@keyframes fall{to{transform:translate(35px,110vh) rotate(520deg)}}

@media(min-width:600px){
  body{padding:20px 0}
  .site{border-radius:16px}
}
@media(prefers-reduced-motion:reduce){
  *,*:before,*:after{animation-duration:.01ms!important;transition-duration:.01ms!important;scroll-behavior:auto!important}
}
</style>
</head>
<body>
<audio id="audio" loop preload="auto"><source src="assets/ambient-instrumental.wav" type="audio/wav"></audio>
<div class="petals" id="petals"></div>

<div class="site">
  <!-- First Page Gatefold Section -->
  <section class="gatefold-stage" id="opening">
    <div class="gatefold-card" id="open" role="button" tabindex="0" aria-label="निमंत्रण खोलें">
      
      <!-- Inner Reveal Villa Card (Direct match to video) -->
      <div class="inner-cover" id="innerCover">
        <img class="inner-cover-img" src="assets/inner-card-clean.jpg" alt="Villa Background">
        
        <!-- Animated Names & Date Overlay -->
        <div class="names-overlay" id="namesOverlay">
          <div class="couple-name name-first" id="name1">Aaditya</div>
          <div class="ampersand" id="amp">&amp;</div>
          <div class="couple-name name-second" id="name2">Arav</div>
          <div class="event-date" id="eventDate">February 21, 2027</div>
        </div>
      </div>

      <!-- Left & Right Doors on top -->
      <div class="door door-left" id="doorLeft"></div>
      <div class="door door-right" id="doorRight"></div>
      <div class="seam-line"></div>

      <!-- Center Ganesha Medallion Seal -->
      <div class="seal-medallion" id="seal">
        <img class="seal-img" src="assets/ganesha-seal-clean.png" alt="श्री गणेशाय नमः">
      </div>

      <!-- Tap to open Pill Button -->
      <button class="tap-open-btn" id="tapBtn" aria-label="Tap to open">
        <svg class="hand-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M18 11V6a2 2 0 0 0-2-2v0a2 2 0 0 0-2 2v0"/>
          <path d="M14 10V4a2 2 0 0 0-2-2v0a2 2 0 0 0-2 2v2"/>
          <path d="M10 10.5V6a2 2 0 0 0-2-2v0a2 2 0 0 0-2 2v8"/>
          <path d="M18 8a2 2 0 1 1 4 0v6a8 8 0 0 1-8 8h-2c-2.8 0-4.5-.86-5.99-2.34l-3.6-3.6a2 2 0 0 1 2.83-2.82L7 15"/>
        </svg>
        <span>Tap to open</span>
      </button>
    </div>
  </section>

  <!-- Complete Invitation Suite (Matching Video Sequence) -->
  <main class="invitation-details" id="details">
    
    <!-- Page 2: Shri Ganeshaya Namah & Sacred Swans in Love -->
    <div class="card-page" id="pageSwans">
      <img src="assets/page2-ganesha-swans.jpg" alt="Shri Ganeshaya Namah — Auspicious Blessing">
    </div>

    <!-- Page 3: The Engagement Day with 21 - 02 - 2027 Pearl Rings -->
    <div class="card-page" id="pageEngagement">
      <img src="assets/page3-engagement.jpg" alt="The Engagement Day — February 21, 2027">
    </div>

    <!-- Page 4: A Heartfelt Invitation Card (Scrollable & Animated) -->
    <div class="heartfelt-page" id="pageHeartfelt">
      <div class="heartfelt-scroll-pane" id="hfScroll">
        <h2 class="heartfelt-title hf-anim hf-title">A Heartfelt Invitation</h2>
        
        <p class="heartfelt-blessing hf-anim hf-blessing">
          By the grace of the Almighty and<br>
          with the blessings of our ancestors, a<br>
          joyous occasion has come to our family.
        </p>

        <p class="heartfelt-announcement hf-anim hf-announcement">
          We are delighted to celebrate the<br>
          auspicious engagement of our beloved son
        </p>

        <div class="heartfelt-couple">
          <div class="couple-name-box hf-anim hf-couple-1">
            <div class="h-name">Aaditya</div>
            <div class="h-sub">Son of Mr. Rajendra Sharma &amp; Mrs. Sunita Sharma</div>
          </div>

          <div class="h-with hf-anim hf-with">
            <span class="leaf-left">❧</span>
            <em>with</em>
            <span class="leaf-right">❧</span>
          </div>

          <div class="couple-name-box hf-anim hf-couple-2">
            <div class="h-name">Arav</div>
            <div class="h-sub">Son / Daughter of Family &amp; Elders</div>
          </div>
        </div>

        <p class="heartfelt-closing hf-anim hf-closing">
          On this joyful occasion, we cordially request<br>
          you and your family to join us and bless the<br>
          couple. Your affection, good wishes and<br>
          gracious presence will be deeply cherished.
        </p>
      </div>
    </div>

    <!-- Page 5: Engagement Celebrations Section (Single Point + Map) -->
    <section class="celebrations-card">
      <h2 class="celebrations-title">Engagement Celebrations</h2>
      
      <div class="timeline-single">
        <!-- Left ceremony royal artwork -->
        <div class="timeline-art">
          <img src="assets/ceremony-stage.png" alt="Engagement Ceremony">
        </div>
        
        <!-- Center vertical pearl line with single glowing pearl node -->
        <div class="timeline-pearl-line">
          <span class="pearl-node"></span>
        </div>
        
        <!-- Right date & ceremony details -->
        <div class="timeline-details">
          <div class="timeline-date">21 February 2027</div>
          <div class="timeline-event-name">ENGAGEMENT CEREMONY</div>
          <div class="timeline-location">From 6:00 PM · The Grand Villa &amp; Gardens</div>
          <a href="https://maps.google.com/?q=The+Grand+Villa+and+Gardens" target="_blank" rel="noopener" class="map-btn">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            <span>View on Google Maps</span>
          </a>
        </div>
      </div>
    </section>

    <!-- Page 6: Family & Loved Ones Toast Card -->
    <div class="card-page" id="pageFamily">
      <img src="assets/card-family-toast.jpg" alt="Blessings from Family &amp; Loved Ones">
    </div>

    <!-- Page 7: A Loving Invitation from the Children Card -->
    <div class="card-page" id="pageChildren">
      <img src="assets/card-children.jpg" alt="A Loving Invitation from the Children">
    </div>

    <!-- Page 8: Interactive RSVP Form Framed with Corinthian Pillars & Garden -->
    <div class="rsvp-pillars-card" id="pageRsvpForm">
      <img src="assets/card-rsvp-pillars-clean.jpg" alt="RSVP Card" class="bg-img">
      
      <form class="rsvp-form-overlay" id="rsvpInteractiveForm">
        <h3 class="rsvp-title">We would love to know<br>if you can join us.</h3>
        
        <div class="rsvp-field">
          <label for="guestName">Your name</label>
          <input type="text" id="guestName" placeholder="Your full name" required>
        </div>

        <div class="rsvp-field">
          <label for="guestPhone">Phone number</label>
          <input type="tel" id="guestPhone" placeholder="+91 98765 43210" required>
        </div>

        <div class="rsvp-field">
          <label>Will you join us?</label>
          <div class="rsvp-choice-row">
            <button type="button" class="rsvp-choice-btn active" id="btnAccept">Joyfully accept</button>
            <button type="button" class="rsvp-choice-btn" id="btnDecline">Regretfully decline</button>
          </div>
        </div>

        <div class="rsvp-field">
          <label for="guestNote">A note for the couple (optional)</label>
          <textarea id="guestNote" rows="2" placeholder="Share a message (optional)"></textarea>
        </div>

        <button type="submit" class="rsvp-send-btn" id="btnSubmitRsvp">Send reply</button>
      </form>
    </div>

    <!-- Page 9: Final French Chateau & Parterre Gardens Card -->
    <div class="card-page" id="pageChateauFinal">
      <img src="assets/card-chateau-final.jpg" alt="Aaditya &amp; Arav — February 21, 2027">
    </div>

    <!-- Countdown Timer -->
    <div class="countdown">
      <div class="count"><b id="days">--</b><span>दिन</span></div>
      <div class="count"><b id="hours">--</b><span>घंटे</span></div>
      <div class="count"><b id="minutes">--</b><span>मिनट</span></div>
      <div class="count"><b id="seconds">--</b><span>सेकंड</span></div>
    </div>

    <footer class="footer">॥ ॐ ॥<br>Your gracious presence will be deeply cherished.<br>सप्रेम एवं सादर — समस्त परिवार</footer>
  </main>
</div>

<script>
const CONFIG = {
  event: "2027-02-21T18:00:00+05:30",
  whatsapp: "", // Add digits only (e.g. "919876543210")
  couple: "Aaditya & Arav"
};

const opening = document.getElementById('opening');
const details = document.getElementById('details');
const openCardTrigger = document.getElementById('open');
const tapBtn = document.getElementById('tapBtn');
const audio = document.getElementById('audio');

function openCard() {
  if (opening.classList.contains('opened')) return;
  
  // Play ambient music loop seamlessly on gesture
  if (audio && audio.paused) {
    audio.play().catch(() => {});
  }
  
  opening.classList.add('opened');
  
  // Smoothly reveal full card suite
  setTimeout(() => {
    details.classList.add('show');
    petalBurst();
  }, 700);
}

openCardTrigger.addEventListener('click', openCard);
if (window.location.search.includes('open=1')) {
  opening.classList.add('opened');
  details.classList.add('show');
  const hf = document.getElementById('pageHeartfelt');
  if (hf) hf.classList.add('is-visible');
}
openCardTrigger.addEventListener('keydown', e => {
  if (e.key === 'Enter' || e.key === ' ') {
    e.preventDefault();
    openCard();
  }
});
if (tapBtn) {
  tapBtn.addEventListener('click', (e) => {
    e.stopPropagation();
    openCard();
  });
}

// Trigger animated entrance for Heartfelt Invitation Card
const hfPage = document.getElementById('pageHeartfelt');
if (hfPage) {
  const hfObserver = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        hfPage.classList.add('is-visible');
      }
    });
  }, { threshold: 0.18 });
  hfObserver.observe(hfPage);
}

// Interactive RSVP Choice Buttons
let attendanceStatus = "Joyfully accept";
const btnAccept = document.getElementById('btnAccept');
const btnDecline = document.getElementById('btnDecline');

if (btnAccept && btnDecline) {
  btnAccept.addEventListener('click', () => {
    attendanceStatus = "Joyfully accept";
    btnAccept.classList.add('active');
    btnDecline.classList.remove('active');
  });
  btnDecline.addEventListener('click', () => {
    attendanceStatus = "Regretfully decline";
    btnDecline.classList.add('active');
    btnAccept.classList.remove('active');
  });
}

// Interactive RSVP Form Submit (via WhatsApp)
const rsvpForm = document.getElementById('rsvpInteractiveForm');
if (rsvpForm) {
  rsvpForm.addEventListener('submit', (e) => {
    e.preventDefault();
    const name = document.getElementById('guestName').value.trim();
    const phone = document.getElementById('guestPhone').value.trim();
    const note = document.getElementById('guestNote').value.trim();

    let text = `*RSVP for ${CONFIG.couple}'s Engagement (21 Feb 2027)*\n\n`;
    text += `👤 *Name:* ${name}\n`;
    text += `📞 *Phone:* ${phone}\n`;
    text += `💌 *Response:* ${attendanceStatus}\n`;
    if (note) text += `💬 *Note:* "${note}"\n`;

    const targetNum = CONFIG.whatsapp || "";
    const waUrl = targetNum 
      ? `https://wa.me/${targetNum}?text=${encodeURIComponent(text)}`
      : `https://wa.me/?text=${encodeURIComponent(text)}`;
    
    window.open(waUrl, '_blank');
  });
}

// Countdown timer
function tick() {
  let n = Math.max(0, new Date(CONFIG.event) - Date.now());
  let a = [
    Math.floor(n / 86400000),
    Math.floor(n / 3600000) % 24,
    Math.floor(n / 60000) % 60,
    Math.floor(n / 1000) % 60
  ];
  ['days','hours','minutes','seconds'].forEach((id, i) => {
    const el = document.getElementById(id);
    if (el) el.textContent = String(a[i]).padStart(2, '0');
  });
}
tick();
setInterval(tick, 1000);

// Petals Falling Effect
function petalBurst() {
  const root = document.getElementById('petals');
  for (let i = 0; i < 28; i++) {
    let p = document.createElement('i');
    p.className = 'petal';
    p.style.left = Math.random() * 100 + '%';
    p.style.animationDuration = (5 + Math.random() * 7) + 's';
    p.style.animationDelay = Math.random() * 1.8 + 's';
    root.appendChild(p);
    setTimeout(() => p.remove(), 14000);
  }
}

setInterval(() => {
  if (details.classList.contains('show')) {
    let p = document.createElement('i');
    p.className = 'petal';
    p.style.left = Math.random() * 100 + '%';
    p.style.animationDuration = (7 + Math.random() * 6) + 's';
    document.getElementById('petals').appendChild(p);
    setTimeout(() => p.remove(), 14000);
  }
}, 1400);
</script>
</body>
</html>